# ============================================================
# PeopleDoxx — Variables de entorno
# Copia este archivo como .env y ajusta los valores
# NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

# --- API (legada, para compatibilidad) ---
API_KEY=dev-key-change-in-production-use-openssl-rand-hex-32

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-jwt-secret-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Admin bootstrap (primer arranque) ---
ADMIN_EMAIL=admin@peopledoxx.local
ADMIN_PASSWORD=ChangeMe!2024

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://peopledoxx:peopledoxx@postgres:5432/peopledoxx
POSTGRES_USER=peopledoxx
POSTGRES_PASSWORD=peopledoxx
POSTGRES_DB=peopledoxx

# --- Scraper ---
REQUEST_DELAY_SECONDS=1.5
CACHE_TTL_SECONDS=3600

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_KEY=dev-key-change-in-production-use-openssl-rand-hex-32
NEXT_PUBLIC_API_URL=http://localhost:8000
