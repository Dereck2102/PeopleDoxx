# PeopleDoxx Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# API key sent as X-API-Key header on every backend request.
# Change this to a strong random secret in production.
NEXT_PUBLIC_API_KEY=dev-key-change-in-production

# Base URL of the PeopleDoxx backend API.
# In development this points to your local backend.
# In Docker Compose this is handled by the proxy rewrite in next.config.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000
